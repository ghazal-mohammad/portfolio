    <script>
        // تغيير favicon حسب theme المتصفح
        (function() {
            function updateFavicon() {
                const favicon = document.getElementById('favicon');
                if (!favicon) return;
                
                // التحقق من theme المتصفح
                const isDarkMode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                
                // تغيير favicon حسب theme
                if (isDarkMode) {
                    // Dark mode: استخدم logo-light.png (لوغو فاتح)
                    favicon.href = "https://widespheres.com/public/images/logo-dark.png";
                } else {
                    // Light mode: استخدم logo-dark.png (لوغو داكن)
                    favicon.href = "https://widespheres.com/public/images/logo-light.png";
                }
            }
            
            // تحديث عند تحميل الصفحة
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', updateFavicon);
            } else {
                updateFavicon();
            }
            
            // الاستماع لتغييرات theme
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateFavicon);
            }
        })();
    </script>

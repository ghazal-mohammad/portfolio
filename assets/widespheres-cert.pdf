    <style>
        html.page-preloading body {
            overflow: hidden;
        }

        html.page-preloading body > *:not(#page-preloader) {
            visibility: hidden;
        }

        #page-preloader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(10, 10, 26, 0.96);
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }

        #page-preloader.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .page-preloader-spinner {
            width: 72px;
            height: 72px;
            object-fit: contain;
            filter: drop-shadow(0 0 14px rgba(151, 124, 184, 0.4));
            animation: preloader-pulse 1.4s ease-in-out infinite;
        }

        @keyframes preloader-pulse {
            0%, 100% {
                opacity: 0.85;
                transform: scale(1);
            }
            50% {
                opacity: 1;
                transform: scale(1.08);
            }
        }
    </style>
    <script>
        document.documentElement.classList.add('page-preloading');
    </script>
    <script src="https://widespheres.com/public/js/i18n.js"></script>
        <style>
        @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');

        .certificate-preview {
            position: relative;
            max-width: 1100px;
            margin: 0 auto;
            border-radius: 12px;
            overflow: hidden;
            --cert-scale: 1;
            user-select: none;
            -webkit-user-drag: none;
        }

        .certificate-text {
            position: absolute;
            transform: translate(-50%, -50%);
            color: #623F9F;
            text-align: center;
            font-family: 'Century Gothic', 'Copperplate Gothic', 'Franklin Gothic Medium', 'Arial', sans-serif;
            line-height: 1.15;
            white-space: nowrap;
        }

        .certificate-text.name {
            font-size: calc(80px * var(--cert-scale));
            font-weight: 700;
            font-family: 'Great Vibes', cursive;
        }

        .certificate-text.title {
            font-size: calc(30px * var(--cert-scale));
            font-weight: 600;
        }

        .certificate-text.meta {
            font-size: calc(20px * var(--cert-scale));
            font-weight: 500;
        }

        .certificate-text.date-text {
            font-family: 'Century Gothic', 'Copperplate Gothic', 'Franklin Gothic Medium', 'Arial', sans-serif;
            letter-spacing: 0.08em;
            direction: ltr;
            unicode-bidi: isolate;
        }

        .certificate-signature {
            max-width: calc(220px * var(--cert-scale));
            max-height: calc(95px * var(--cert-scale));
            display: block;
        }

        @media (max-width: 768px) {
            .certificate-preview {
                --cert-scale: 0.5;
            }

            .certificate-signature {
                max-width: calc(240px * var(--cert-scale));
                max-height: calc(120px * var(--cert-scale));
            }
        }

        .certificate-preview.pdf-export-mode .certificate-text {
            margin-top: -5px;
        }
    </style>
</head>

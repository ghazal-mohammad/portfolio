    <script>
        (function() {
            let revealed = false;

            function revealPage() {
                if (revealed) return;
                revealed = true;
                document.documentElement.classList.remove('page-preloading');
                const preloader = document.getElementById('page-preloader');
                if (preloader) preloader.classList.add('hidden');
            }

            document.addEventListener('app:ready', revealPage, { once: true });
            window.addEventListener('load', function() {
                setTimeout(revealPage, 300);
            }, { once: true });
            setTimeout(revealPage, 4000);
        })();
    </script>
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script>
        (function () {
            const preview = document.getElementById('certificatePreview');
            if (!preview) return;

            function updateScale() {
                const width = preview.clientWidth || 1100;
                const scale = Math.max(0.35, Math.min(1, width / 1100));
                preview.style.setProperty('--cert-scale', scale.toFixed(4));
            }

            updateScale();
            window.addEventListener('resize', updateScale);
        })();

        (function () {
            const downloadBtn = document.getElementById('downloadCertificatePdf');
            const preview = document.getElementById('certificatePreview');
            if (!downloadBtn || !preview) return;

            const originalHref = downloadBtn.getAttribute('href');
            const reference = downloadBtn.getAttribute('data-reference') || 'certificate';
            const certificateUrl = downloadBtn.getAttribute('data-certificate-url') || '';
            let isGenerating = false;

            downloadBtn.addEventListener('click', async function (event) {
                event.preventDefault();
                if (isGenerating) return;

                isGenerating = true;
                const originalHtml = downloadBtn.innerHTML;
                downloadBtn.style.pointerEvents = 'none';
                downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحضير...';

                try {
                    if (document.fonts && typeof document.fonts.ready !== 'undefined') {
                        await document.fonts.ready;
                    }

                    preview.classList.add('pdf-export-mode');
                    const canvas = await html2canvas(preview, {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: null
                    });
                    preview.classList.remove('pdf-export-mode');

                    const imageData = canvas.toDataURL('image/png');
                    const jsPDF = window.jspdf && window.jspdf.jsPDF;

                    if (!jsPDF) {
                        window.location.href = originalHref;
                        return;
                    }

                    const pdf = new jsPDF({
                        orientation: canvas.width >= canvas.height ? 'landscape' : 'portrait',
                        unit: 'pt',
                        format: [canvas.width, canvas.height]
                    });

                    pdf.addImage(imageData, 'PNG', 0, 0, canvas.width, canvas.height);
                    const referenceLabel = 'Ref: ' + reference;
                    const linkX = 16;
                    const linkY = canvas.height - 12;
                    pdf.setTextColor(98, 63, 159);
                    pdf.setFontSize(10);
                    if (certificateUrl && typeof pdf.textWithLink === 'function') {
                        pdf.textWithLink(referenceLabel, linkX, linkY, { url: certificateUrl });
                    } else {
                        pdf.text(referenceLabel, linkX, linkY);
                    }
                    pdf.save('certificate-' + reference + '.pdf');
                } catch (error) {
                    preview.classList.remove('pdf-export-mode');
                    window.location.href = originalHref;
                } finally {
                    isGenerating = false;
                    downloadBtn.style.pointerEvents = '';
                    downloadBtn.innerHTML = originalHtml;
                }
            });
        })();

        (function () {
            const preview = document.getElementById('certificatePreview');
            if (!preview) return;

            preview.addEventListener('contextmenu', function (event) {
                event.preventDefault();
            });

            preview.querySelectorAll('img').forEach(function (img) {
                img.addEventListener('dragstart', function (event) {
                    event.preventDefault();
                });
            });
        })();

        (function () {
            const preview = document.getElementById('certificatePreview');
            const shouldAutoDownloadImage = false;
            if (!preview || !shouldAutoDownloadImage) return;

            async function waitForPreviewReady() {
                const images = Array.from(preview.querySelectorAll('img'));
                await Promise.all(images.map(function (img) {
                    if (img.complete && img.naturalWidth > 0) {
                        return Promise.resolve();
                    }
                    return new Promise(function (resolve) {
                        img.addEventListener('load', resolve, { once: true });
                        img.addEventListener('error', resolve, { once: true });
                    });
                }));

                // Ensure layout is settled and preview has measurable size.
                for (let i = 0; i < 15; i++) {
                    const width = preview.getBoundingClientRect().width;
                    const height = preview.getBoundingClientRect().height;
                    if (width > 200 && height > 100) {
                        return;
                    }
                    await new Promise(function (resolve) { setTimeout(resolve, 120); });
                }
            }

            async function downloadAsImage() {
                if (document.fonts && typeof document.fonts.ready !== 'undefined') {
                    await document.fonts.ready;
                }
                await waitForPreviewReady();

                const canvas = await html2canvas(preview, {
                    scale: 3,
                    useCORS: true,
                    backgroundColor: null,
                    width: Math.ceil(preview.scrollWidth || preview.getBoundingClientRect().width),
                    height: Math.ceil(preview.scrollHeight || preview.getBoundingClientRect().height)
                });

                const link = document.createElement('a');
                link.href = canvas.toDataURL('image/png');
                link.download = 'certificate-CERT-2026-P9BHRKXL.png';
                document.body.appendChild(link);
                link.click();
                link.remove();
            }

            window.addEventListener('load', function () {
                downloadAsImage().catch(function () {
                    // Keep page usable even if download fails.
                });
            });
        })();
    </script>
    <style>
        /* Stars Background Animation */
        .stars-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
        }
        
        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: white;
            border-radius: 50%;
            animation: twinkle 3s infinite;
        }
        
        .star:nth-child(1) { top: 10%; left: 20%; animation-delay: 0s; }
        .star:nth-child(2) { top: 20%; left: 50%; animation-delay: 0.5s; }
        .star:nth-child(3) { top: 30%; left: 80%; animation-delay: 1s; }
        .star:nth-child(4) { top: 40%; left: 15%; animation-delay: 1.5s; }
        .star:nth-child(5) { top: 50%; left: 60%; animation-delay: 2s; }
        .star:nth-child(6) { top: 60%; left: 30%; animation-delay: 0.3s; }
        .star:nth-child(7) { top: 70%; left: 70%; animation-delay: 0.8s; }
        .star:nth-child(8) { top: 15%; left: 40%; animation-delay: 1.2s; }
        .star:nth-child(9) { top: 25%; left: 90%; animation-delay: 1.7s; }
        .star:nth-child(10) { top: 35%; left: 10%; animation-delay: 2.2s; }
        .star:nth-child(11) { top: 45%; left: 55%; animation-delay: 0.6s; }
        .star:nth-child(12) { top: 55%; left: 25%; animation-delay: 1.1s; }
        .star:nth-child(13) { top: 65%; left: 75%; animation-delay: 1.6s; }
        .star:nth-child(14) { top: 75%; left: 45%; animation-delay: 2.1s; }
        .star:nth-child(15) { top: 85%; left: 85%; animation-delay: 0.4s; }
        .star:nth-child(16) { top: 5%; left: 35%; animation-delay: 0.9s; }
        .star:nth-child(17) { top: 95%; left: 65%; animation-delay: 1.4s; }
        .star:nth-child(18) { top: 12%; left: 5%; animation-delay: 1.9s; }
        .star:nth-child(19) { top: 22%; left: 95%; animation-delay: 2.4s; }
        .star:nth-child(20) { top: 32%; left: 65%; animation-delay: 0.7s; }
        
        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.5); }
        }
        
        /* Meteors Container */
        .meteors-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
        }
        
        /* Shooting Stars - Interactive */
        .shooting-star {
            position: absolute;
            width: 3px;
            height: 120px;
            background: linear-gradient(to bottom, rgba(255,255,255,1), rgba(98, 63, 159, 0.8), rgba(255,255,255,0));
            z-index: 1;
            animation-iteration-count: infinite;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 20px rgba(98, 63, 159, 0.6);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .shooting-star:hover {
            width: 5px;
            height: 150px;
            box-shadow: 0 0 20px rgba(255, 255, 255, 1), 0 0 40px rgba(98, 63, 159, 0.8);
        }
        
        .meteors-container .shooting-star:nth-child(1) {
            left: 10%;
            animation-delay: 0s;
            transform: rotate(45deg);
            animation-duration: 4s;
            animation-name: shoot1;
        }
        
        @keyframes shoot1 {
            0% { top: -120px; left: 10%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 40%; opacity: 0; }
        }
        
        .meteors-container .shooting-star:nth-child(2) {
            left: 30%;
            animation-delay: 0.8s;
            transform: rotate(50deg);
            animation-duration: 5s;
            animation-name: shoot2;
        }
        
        @keyframes shoot2 {
            0% { top: -120px; left: 30%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 60%; opacity: 0; }
        }
        
        .meteors-container .shooting-star:nth-child(3) {
            left: 50%;
            animation-delay: 1.6s;
            transform: rotate(45deg);
            animation-duration: 4.5s;
            animation-name: shoot3;
        }
        
        @keyframes shoot3 {
            0% { top: -120px; left: 50%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 80%; opacity: 0; }
        }
        
        .meteors-container .shooting-star:nth-child(4) {
            left: 70%;
            animation-delay: 2.4s;
            transform: rotate(55deg);
            animation-duration: 5.5s;
            animation-name: shoot4;
        }
        
        @keyframes shoot4 {
            0% { top: -120px; left: 70%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 100%; opacity: 0; }
        }
        
        .meteors-container .shooting-star:nth-child(5) {
            left: 20%;
            animation-delay: 3.2s;
            transform: rotate(48deg);
            animation-duration: 4.8s;
            animation-name: shoot5;
        }
        
        @keyframes shoot5 {
            0% { top: -120px; left: 20%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 50%; opacity: 0; }
        }
        
        .meteors-container .shooting-star:nth-child(6) {
            left: 85%;
            animation-delay: 4s;
            transform: rotate(52deg);
            animation-duration: 5.2s;
            animation-name: shoot6;
        }
        
        @keyframes shoot6 {
            0% { top: -120px; left: 85%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: calc(100vh + 120px); left: 115%; opacity: 0; }
        }
        
        /* Planets */
        .planet {
            position: absolute;
            border-radius: 50%;
            z-index: 1;
            animation: floatPlanet 20s infinite ease-in-out;
            box-shadow: 0 0 30px rgba(98, 63, 159, 0.4), inset -20px -20px 30px rgba(0, 0, 0, 0.3);
        }
        
        .planet-1 {
            width: 80px;
            height: 80px;
            background: radial-gradient(circle at 30% 30%, rgba(151, 124, 184, 0.8), rgba(98, 63, 159, 0.6));
            top: 10%;
            left: 5%;
            animation-duration: 25s;
            animation-delay: 0s;
        }
        
        .planet-2 {
            width: 60px;
            height: 60px;
            background: radial-gradient(circle at 30% 30%, rgba(98, 63, 159, 0.7), rgba(61, 31, 111, 0.5));
            top: 60%;
            left: 85%;
            animation-duration: 30s;
            animation-delay: 5s;
        }
        
        .planet-3 {
            width: 100px;
            height: 100px;
            background: radial-gradient(circle at 30% 30%, rgba(151, 124, 184, 0.6), rgba(38, 11, 81, 0.4));
            top: 30%;
            left: 75%;
            animation-duration: 35s;
            animation-delay: 10s;
        }
        
        .planet-4 {
            width: 50px;
            height: 50px;
            background: radial-gradient(circle at 30% 30%, rgba(98, 63, 159, 0.8), rgba(61, 31, 111, 0.6));
            top: 80%;
            left: 15%;
            animation-duration: 28s;
            animation-delay: 7s;
        }
        
        @keyframes floatPlanet {
            0%, 100% {
                transform: translate(0, 0) scale(1);
            }
            25% {
                transform: translate(20px, -30px) scale(1.1);
            }
            50% {
                transform: translate(-15px, -20px) scale(0.95);
            }
            75% {
                transform: translate(25px, 15px) scale(1.05);
            }
        }
        
        .planet:hover {
            transform: scale(1.3);
            box-shadow: 0 0 50px rgba(98, 63, 159, 0.8), inset -20px -20px 30px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }
    </style>
    
    <script>
        // Interactive Shooting Stars and Planets
        (function() {
            const footer = document.querySelector('.footer');
            if (!footer) return;
            
            const shootingStars = footer.querySelectorAll('.meteors-container .shooting-star');
            const planets = footer.querySelectorAll('.planet');
            
            // Make shooting stars interactive with mouse
            shootingStars.forEach((star, index) => {
                // Set CSS variables for dynamic animation
                const startLeft = parseFloat(getComputedStyle(star).left) || (index * 10 + 10);
                const rotation = 45 + (index % 3) * 5;
                star.style.setProperty('--start-left', startLeft + '%');
                star.style.setProperty('--rotation', rotation + 'deg');
                
                // Mouse interaction
                star.addEventListener('mouseenter', () => {
                    star.style.animationPlayState = 'paused';
                    star.style.transform = `rotate(${rotation}deg) scale(1.5)`;
                    star.style.boxShadow = '0 0 30px rgba(255, 255, 255, 1), 0 0 60px rgba(98, 63, 159, 1)';
                });
                
                star.addEventListener('mouseleave', () => {
                    star.style.animationPlayState = 'running';
                    star.style.transform = `rotate(${rotation}deg) scale(1)`;
                    star.style.boxShadow = '0 0 10px rgba(255, 255, 255, 0.8), 0 0 20px rgba(98, 63, 159, 0.6)';
                });
            });
            
            // Make planets interactive with mouse parallax
            footer.addEventListener('mousemove', (e) => {
                const rect = footer.getBoundingClientRect();
                const mouseX = (e.clientX - rect.left) / rect.width;
                const mouseY = (e.clientY - rect.top) / rect.height;
                
                planets.forEach((planet, index) => {
                    const intensity = (index + 1) * 15;
                    const moveX = (mouseX - 0.5) * intensity;
                    const moveY = (mouseY - 0.5) * intensity;
                    
                    planet.style.transform = `translate(${moveX}px, ${moveY}px) scale(1)`;
                });
            });
            
            // Reset planets on mouse leave
            footer.addEventListener('mouseleave', () => {
                planets.forEach((planet) => {
                    planet.style.transform = 'translate(0, 0) scale(1)';
                });
            });
        })();
    </script>
</body>
</html>




